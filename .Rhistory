library(pampam)
set.seed(123)
# dimensions
n <- 100   # observations
p <- 5     # features
K <- 3     # classes
# design matrix
x <- matrix(rnorm(n * p), n, p)
# multinomial response (factor with K classes)
y <- factor(sample(1:K, n, replace = TRUE))
# penalty matrix (K x p)
penalty <- matrix(1, K, p)
library(pampam)
fit <- pampam(
x, y,
family = "multinomial",
penalty.factor = penalty
)
# penalty matrix (K x p)
penalty <- matrix(1, p, K)
library(pampam)
fit <- pampam(
x, y,
family = "multinomial",
penalty.factor = penalty
)
print(fit)
