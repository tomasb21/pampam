fit_to_coefmatrix
fit_to_coefmatrix <- function(fit, lambda) {
coef <- coef(fit, s = lambda)
ncols <- length(coef)
nrows <- length(coef[[1]])
matrix <- matrix(0, nrow = nrows, ncol = ncols)
for (i in 1:ncols) {
matrix[, i] <- coef[[i]][,1]
i <- i + 1
}
rownames(matrix) <- rownames(coef[[1]])
return(matrix)
}
