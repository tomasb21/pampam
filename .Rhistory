library(glmnet)
library(pampam)
set.seed(123)
# -----------------------------
# Simulate data
# -----------------------------
n <- 100
p <- 20
x <- matrix(rnorm(n * p), n, p)
beta <- c(runif(5, -2, 2), rep(0, p - 5))
prob <- 1 / (1 + exp(-x %*% beta))
y <- rbinom(n, 1, prob)
# -----------------------------
# Fit glmnet
# -----------------------------
fit_glmnet <- glmnet(
x, y,
family = "binomial",
alpha = 1,
standardize = TRUE
)
# -----------------------------
# Fit pampam
# -----------------------------
fit_pampam <- pampam(
x, y,
family = "binomial",
alpha = 1,
standardize = TRUE,
penalty.factor = matrix(1, nrow = p, ncol = 1)  # IMPORTANT
)
fit_pampam
fit_glmnet
# -----------------------------
# Compare lambda sequences
# -----------------------------
cat("Lambda equal:\n")
print(all.equal(fit_glmnet$lambda, fit_pampam$lambda, tolerance = 1e-12))
# -----------------------------
# Compare coefficients
# -----------------------------
coef_glmnet <- as.matrix(coef(fit_glmnet))
coef_pampam <- as.matrix(coef(fit_pampam))
cat("\nMax abs diff (coefficients):\n")
print(max(abs(coef_glmnet - coef_pampam)))
# -----------------------------
# Compare predictions
# -----------------------------
pred_glmnet <- predict(fit_glmnet, x, type = "response")
pred_pampam <- predict(fit_pampam, x, type = "response")
cat("\nMax abs diff (predictions):\n")
print(max(abs(pred_glmnet - pred_pampam)))
# -----------------------------
# Strict equality checks
# -----------------------------
cat("\nAll.equal coefficients:\n")
print(all.equal(coef_glmnet, coef_pampam, tolerance = 1e-10))
cat("\nAll.equal predictions:\n")
print(all.equal(pred_glmnet, pred_pampam, tolerance = 1e-10))
