set.seed(123)
n <- 150
p <- 20
K <- 3
# -----------------------------
# Simulate data
# -----------------------------
x <- matrix(rnorm(n * p), n, p)
# create class-specific signals
beta <- matrix(0, p, K)
beta[1:3, 1] <- 2      # strong signal for class 1
beta[4:6, 2] <- -2     # strong signal for class 2
beta[7:9, 3] <- 1.5    # strong signal for class 3
beta
eta <- x %*% beta
prob <- exp(eta)
prob <- prob / rowSums(prob)
y_multi <- apply(prob, 1, function(pr) sample(1:K, 1, prob = pr))
y_multi
# -----------------------------
# 1. Baseline (should match glmnet)
# -----------------------------
fit_glmnet <- glmnet(x, y_multi, family = "multinomial")
fit_pampam_base <- pampam(
x, y_multi,
family = "multinomial",
penalty.factor = matrix(1, p, K)
)
cat("Baseline match (coefficients):\n")
print(all.equal(
coef(fit_glmnet)[[1]],
coef(fit_pampam_base)[[1]],
tolerance = 1e-10
))
fit_pampam_base
fit_pampam_base
matrix(1, p, K)
# -----------------------------
# 2. Custom penalty (your feature)
# -----------------------------
pf <- matrix(1, p, K)
# Make class 1 LESS penalized, class 2 MORE penalized
pf[,1] <- 0.5
pf[,2] <- 2
pf[,3] <- 1
fit_pampam_custom <- pampam(
x, y_multi,
family = "multinomial",
penalty.factor = pf
)
# -----------------------------
# 3. Compare coefficients
# -----------------------------
coef_base <- coef(fit_pampam_base)
coef_custom <- coef(fit_pampam_custom)
# pick a lambda index (middle of path)
idx <- round(length(fit_pampam_base$lambda) / 2)
cat("\nMax abs diff (class 1):\n")
print(max(abs(coef_base[[1]][,idx] - coef_custom[[1]][,idx])))
coef_custom
coef_base
