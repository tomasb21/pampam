set.seed(1)
n <- 100
p <- 5
K <- 3

x <- matrix(rnorm(n * p), nrow = n, ncol = p)
y <- factor(sample(seq_len(K), n, replace = TRUE))

penalty <- matrix(runif(p * K, 0.5, 2), nrow = p, ncol = K)

fit <- pampam(
